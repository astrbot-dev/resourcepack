                            "model": "astrbot:bot/heavy"
                        },
                        {
                            "type": "select",
                            "property": "custom_model_data",
                            "index": 1,
                            "cases": [
                                {
                                    "when": "fall_prevention",
                                    "model": {
                                        "type": "minecraft:model",
                                        "model": "astrbot:modules/heavy_left/protection"
                                    }
                                },
                                {
                                    "when": "backpack",
                                    "model": {
                                        "type": "minecraft:model",
                                        "model": "astrbot:modules/heavy_left/backpack"
                                    }
                                },
                                {
                                    "when": "mending_servicer",
                                    "model": {
                                        "type": "minecraft:model",
                                        "model": "astrbot:modules/heavy_left/mending"
                                    }
                                },
                                {
                                    "when": "solar_energy",
                                    "model": {
                                        "type": "minecraft:model",
                                        "model": "astrbot:modules/heavy_left/solar"
                                    }
                                }
                            ],
